# Local synthetic demo only. Generate distinct random secrets before startup.
AGENTMALL_POSTGRES_PASSWORD=replace-with-a-random-hex-password
AGENTMALL_DATABASE_URL=postgresql+psycopg://agentmall:replace-with-a-random-hex-password@127.0.0.1:55432/agentmall
AGENTMALL_TEST_DATABASE_URL=postgresql+psycopg://agentmall:replace-with-a-random-hex-password@127.0.0.1:55432/agentmall_test
AGENTMALL_JWT_SECRET=replace-with-at-least-32-random-characters
AGENTMALL_STOREFRONT_ID=00000000-0000-0000-0000-000000000001

# T05 controlled server outcome; allowed values: SUCCEEDED, DECLINED.
# Changing this setting never changes an already completed action's receipt.
AGENTMALL_MOCK_PAYMENT_RESULT=SUCCEEDED

# T03: normal API startup does not load provider credentials or make paid requests.
# Supply DEEPSEEK_API_KEY only in the local process environment for the explicitly
# authorized evals/live_smoke.py --live command. Never put it in tracked files.
# Model: deepseek-flash; thinking disabled; max output 2048; retries 0.
# One dated live purchase ledger, at most 8 requests and CNY 3 (conservative cap).
