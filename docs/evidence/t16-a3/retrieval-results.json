  "recall_sql_without_parameters": [
    "SELECT product_search.product_id, product_search.source_version, product_search.content_hash FROM product_search JOIN products ON products.id = product_search.product_id WHERE products.store_id = %(store_id_1)s::UUID AND products.active IS true AND products.catalog_version = product_search.source_version AND products.category = %(category_1)s::VARCHAR AND products.price_cents <= %(price_cents_1)s::BIGINT AND products.on_hand > products.reserved AND CAST((products.attributes ->> %(attributes_1)s::TEXT) AS VARCHAR) = %(param_1)s::VARCHAR AND (NOT ((products.attributes ? %(attributes_2)s::VARCHAR)) AND CAST((products.attributes ->> %(attributes_3)s::TEXT) AS VARCHAR) = %(param_2)s::VARCHAR OR CAST((products.attributes ->> %(attributes_3)s::TEXT) AS VARCHAR) IN (%(param_3_1)s::VARCHAR, %(param_3_2)s::VARCHAR, %(param_3_3)s::VARCHAR) AND jsonb_typeof(products.attributes[%(attributes_4)s::TEXT]) = %(jsonb_typeof_1)s::VARCHAR AND (products.attributes[%(attributes_4)s::TEXT] <@ %(param_4)s::JSONB) AND (products.attributes[%(attributes_4)s::TEXT] @> %(param_5)s::JSONB)) AND product_search.embedding_model = %(embedding_model_1)s::VARCHAR AND product_search.embedding_revision = %(embedding_revision_1)s::VARCHAR AND product_search.tokenizer_version = %(tokenizer_version_1)s::VARCHAR AND (product_search.search_tsv @@ to_tsquery(%(to_tsquery_1)s::REGCONFIG, %(to_tsquery_2)s::VARCHAR)) ORDER BY ts_rank_cd(product_search.search_tsv, to_tsquery(%(to_tsquery_1)s::REGCONFIG, %(to_tsquery_2)s::VARCHAR)) DESC, product_search.product_id LIMIT %(param_6)s::INTEGER",
